{
  "source_extensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".py",
    ".go",
    ".rs",
    ".rb",
    ".java",
    ".kt",
    ".swift",
    ".vue",
    ".svelte"
  ],
  "test_patterns": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.*",
    "**/__tests__/**"
  ],
  "folder_limit": 15,
  "prefix_cluster": 4,
  "frozen": [
    "plugins/forger/engine/src"
  ],
  "server_guards": [],
  "boundaries": [
    {
      "name": "adapters",
      "paths": [
        "plugins/forger/engine/src/adapters/**"
      ],
      "may_import": [
        "core"
      ]
    },
    {
      "name": "cli",
      "paths": [
        "plugins/forger/engine/src/cli/**",
        "plugins/forger/bin/**"
      ],
      "may_import": [
        "core",
        "adapters"
      ]
    },
    {
      "name": "core",
      "paths": [
        "plugins/forger/engine/src/**"
      ],
      "may_import": []
    }
  ],
  "cycles": true,
  "review": {
    "every_merged": 25,
    "warnings_over": 40
  },
  "entry_files": [
    "index.*"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/vendor/**",
    "**/generated/**",
    "**/*.d.ts",
    "test/fixtures/**"
  ]
}
