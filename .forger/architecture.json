{
  "layers": [
    {"name": "tests", "paths": ["plugins/forger/engine/src/**/*.test.ts"]},
    {"name": "adapters", "paths": ["plugins/forger/engine/src/adapters/**"]},
    {"name": "cli", "paths": ["plugins/forger/engine/src/cli/**", "plugins/forger/bin/**"]},
    {"name": "core", "paths": ["plugins/forger/engine/src/**"]}
  ],
  "allow": {
    "tests": ["core", "adapters", "cli"],
    "adapters": ["core"],
    "cli": ["core", "adapters"]
  },
  "modules": {"paths": ["plugins/forger/engine/src/*"], "entry": "index.ts"}
}
