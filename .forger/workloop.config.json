{
  "repo": null,
  "worker_command": "forger:auto-ticket",
  "gates": "cd tools/brand && bun install --frozen-lockfile && bun run check && cd ../.. && cd plugins/forger/engine && bun install --frozen-lockfile && bun run check && cd ../../.. && bun plugins/forger/bin/work.ts check",
  "base_branch": "main",
  "tracker": {
    "kind": "github",
    "label": "ready-for-agent",
    "ignore": [
      "wayfinder:*"
    ]
  },
  "state": {
    "home": "branch",
    "branch": "forger-state"
  },
  "parallelism": 2,
  "release": {
    "files": [
      {
        "path": "plugins/forger/.claude-plugin/plugin.json",
        "key": "version"
      },
      {
        "path": "plugins/forger/engine/package.json",
        "key": "version"
      }
    ],
    "changelog": "CHANGELOG.md"
  }
}
