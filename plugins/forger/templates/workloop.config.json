{
  "repo": null,
  "worker_command": "forger:auto-ticket",
  "gates": "npm run typecheck && npm run lint && npm test",
  "base_branch": "main",
  "model_by_priority": {
    "P0": { "model": "opus", "budget": 22.5 },
    "default": { "model": "sonnet", "budget": 18.0 }
  },
  "effort_multiplier": { "small": 1, "medium": 1.5, "large": 2.5 },
  "limits": {
    "timeoutMinutes": 45,
    "killGraceSeconds": 30,
    "maxConsecutiveFailures": 3,
    "pauseBetweenIterations": 5000,
    "pauseAfterFailure": 10000,
    "maxStallIterations": 5
  },
  "paths": {
    "backlog": ".forger/backlog.json",
    "state": ".forger/state.json",
    "log": ".forger/work.log",
    "output": ".forger/output",
    "halt": ".forger/HALT",
    "lock": ".forger/runner.lock",
    "events": ".forger/events.jsonl",
    "declined": ".forger/declined.json"
  },
  "skills": {},
  "tracker": { "kind": "github", "label": "ready-for-agent", "ignore": ["wayfinder:*"] }
}
